APP_ENV=development
HOST=127.0.0.1
PORT=8090

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking123
POSTGRES_DB=booking
POSTGRES_SSLMODE=disable

ACCESS_TOKEN_TTL=15m
SESSION_TTL=24h

MIGRATIONS_DIR=migrations

# Comma-separated browser origins allowed to call this API directly (CORS).
# Leave empty to disable cross-origin browser access entirely.
ALLOWED_ORIGINS=http://localhost:3000

# Refresh-cookie flags. The refresh credential is delivered as an HttpOnly
# cookie so browser JavaScript can never read it.
#
# COOKIE_SECURE defaults to true in production and false in development
# (local dev is plain HTTP, where a Secure cookie would never be stored).
# COOKIE_SAMESITE defaults to Lax, which is correct whenever the browser app
# and this API share a registrable domain — including localhost:3000 calling
# localhost:8090, since the differing port does not make a request cross-site.
# Set None only for a genuinely cross-site deployment; browsers honor it only
# together with COOKIE_SECURE=true, and startup refuses the unsafe combination.
# COOKIE_SECURE=false
# COOKIE_SAMESITE=Lax

# --- Sign in with Google (OAuth 2.0 / OpenID Connect) -----------------------
#
# Optional as a group: leave all four unset and the API starts normally with
# the feature switched off (GET /api/v1/auth/google then answers 503
# SERVICE_UNAVAILABLE). Set any one of them and startup REQUIRES all four -
# a half-configured deployment would otherwise boot, show a Google button, and
# only fail after the user had already authenticated at Google.
#
# GOOGLE_CLIENT_SECRET is a server-only credential. It is never sent to the
# browser, never logged, and must never be copied into a NEXT_PUBLIC_* variable
# in the frontend. GOOGLE_CLIENT_ID is not needed by the frontend either: the
# backend composes the Google authorization URL.
#
# GOOGLE_REDIRECT_URL must be the absolute URL of THIS API's callback route and
# must be registered verbatim in the Google Cloud console under
# "Authorized redirect URIs". Startup rejects a value that does not end in
# /api/v1/auth/google/callback, and requires https when APP_ENV=production.
#
# FRONTEND_URL is the browser application's origin and is the ONLY destination
# the OAuth callback will redirect a signed-in browser to.
# GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost:8090/api/v1/auth/google/callback
# FRONTEND_URL=http://localhost:3000
#GOOGLE_REDIRECT_URL:http://localhost:8090/api/v1/auth/google/callback

